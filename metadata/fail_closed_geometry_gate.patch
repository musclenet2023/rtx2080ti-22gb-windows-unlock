+/// Pure host-test twin of the loader's TU10x LMR decoder.
+pub fn decode_tu10x_local_memory_range(lmr: u32) -> Option<u32> {
+    if matches!(lmr, 0 | u32::MAX) || lmr & 0xffff_0000 == 0xbadf_0000 {
+        return None;
+    }
+    let mag = (lmr >> 4) & 0x3f;
+    let scale = lmr & 0xf;
+    let bytes = (mag as u64).checked_shl(scale + 20)?;
+    let bytes = if lmr & (1 << 30) != 0 {
+        bytes.checked_div(16)?.checked_mul(15)?
+    } else {
+        bytes
+    };
+    let mib = u32::try_from(bytes >> 20).ok()?;
+    (256..=64 * 1024).contains(&mib).then_some(mib)
+}
