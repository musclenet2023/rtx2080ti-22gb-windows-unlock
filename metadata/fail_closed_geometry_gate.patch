+pub fn decode_tu10x_local_memory_range(lmr: u32) -> Option<u32> {
+    if inaccessible(lmr) {
+        return None;
+    }
+    let mag = (lmr >> 4) & 0x3f;
+    let scale = lmr & 0xf;
+    let bytes = (mag as u64).checked_shl(scale + 20)?;
